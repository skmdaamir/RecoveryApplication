<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.recoveryx.ui.controller.scan.ScanResultsController">

    <top>
        <VBox spacing="0.0" styleClass="top-shell">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar">
                    <children>
                        <Label text="RecoveryX Pro" styleClass="app-title"/>
                        <Separator orientation="VERTICAL"/>
                        <Label fx:id="scanTitleLabel" text="Scan Results" styleClass="page-title"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label fx:id="fileCountLabel" text="0 files found" styleClass="count-badge"/>
                        <Button fx:id="backButton"
                                mnemonicParsing="false"
                                onAction="#onBack"
                                text="← Back"
                                styleClass="secondary-button"/>
                        <Button fx:id="cancelScanButton"
                                mnemonicParsing="false"
                                onAction="#onCancelScan"
                                text="Stop Scan"
                                styleClass="danger-button"/>
                        <Button fx:id="recoverButton"
                                mnemonicParsing="false"
                                onAction="#onRecoverSelected"
                                text="Recover Selected"
                                styleClass="primary-button"
                                disable="true"/>
                    </children>
                    <padding>
                        <Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/>
                    </padding>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="12.0" styleClass="content-shell">
            <children>

                <!-- Progress Section -->
                <VBox fx:id="progressSection" spacing="8.0" styleClass="progress-panel">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label fx:id="progressLabel" text="Scanning..." styleClass="progress-title"/>
                                <HBox HBox.hgrow="ALWAYS"/>
                                <Label fx:id="progressPercentLabel" text="0%" styleClass="progress-percent"/>
                            </children>
                        </HBox>
                        <ProgressBar fx:id="scanProgressBar" progress="0.0" maxWidth="1.7976931348623157E308"/>
                        <Label fx:id="progressDetailLabel" text="Preparing scan..." styleClass="progress-detail"/>
                    </children>
                    <padding>
                        <Insets top="14.0" right="18.0" bottom="12.0" left="18.0"/>
                    </padding>
                </VBox>

                <!-- Select All + Filter row -->
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <children>
                        <CheckBox fx:id="selectAllCheckBox" text="Select All" onAction="#onSelectAll"/>
                        <Separator orientation="VERTICAL"/>
                        <Label text="Filter:" styleClass="filter-label"/>
                        <Button fx:id="filterAllBtn" text="All" onAction="#onFilterAll" styleClass="filter-button-active"/>
                        <Button fx:id="filterPhotosBtn" text="Photos" onAction="#onFilterPhotos" styleClass="filter-button"/>
                        <Button fx:id="filterDocsBtn" text="Documents" onAction="#onFilterDocs" styleClass="filter-button"/>
                        <Button fx:id="filterVideoBtn" text="Videos" onAction="#onFilterVideo" styleClass="filter-button"/>
                        <Button fx:id="filterOtherBtn" text="Other" onAction="#onFilterOther" styleClass="filter-button"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label fx:id="selectedCountLabel" text="0 selected" styleClass="selected-count"/>
                    </children>
                    <padding>
                        <Insets top="4.0" right="18.0" bottom="0.0" left="18.0"/>
                    </padding>
                </HBox>

                <!-- Results Table -->
                <TableView fx:id="resultsTable"
                           VBox.vgrow="ALWAYS"
                           styleClass="results-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="selectColumn" text="✓" prefWidth="50.0" maxWidth="50.0"/>
                        <TableColumn fx:id="nameColumn" text="File Name" prefWidth="220.0"/>
                        <TableColumn fx:id="extensionColumn" text="Type" prefWidth="80.0"/>
                        <TableColumn fx:id="sizeColumn" text="Size" prefWidth="100.0"/>
                        <TableColumn fx:id="deletedDateColumn" text="Deleted / Modified" prefWidth="170.0"/>
                        <TableColumn fx:id="pathColumn" text="Original Path" prefWidth="250.0"/>
                        <TableColumn fx:id="chanceColumn" text="Recovery Chance" prefWidth="150.0"/>
                    </columns>
                    <VBox.margin>
                        <Insets top="0.0" right="18.0" bottom="0.0" left="18.0"/>
                    </VBox.margin>
                </TableView>

                <!-- Status bar -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="status-bar">
                    <children>
                        <Label fx:id="statusLabel" text="Ready" styleClass="status-text"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label fx:id="destinationLabel" text="" styleClass="destination-text"/>
                    </children>
                    <padding>
                        <Insets top="10.0" right="18.0" bottom="14.0" left="18.0"/>
                    </padding>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>
